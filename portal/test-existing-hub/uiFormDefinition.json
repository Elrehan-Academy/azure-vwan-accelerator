{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Elrehan Academy — Test an Existing Hub",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "elements": [
            {
              "name": "solutionIntroduction",
              "type": "Microsoft.Common.InfoBox",
              "visible": true,
              "options": {
                "icon": "Info",
                "text": "Test an existing secured virtual hub. Choose a dedicated automation resource group. Creates two billable private VMs in a separate test RG, temporary hub connections and firewall rules. Requires permission to create resource groups and assign roles. Download evidence within 24 hours."
              }
            },
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "location": {
                "resourceTypes": [
                  "microsoft.resources/resourcegroups"
                ]
              }
            }
          ]
        },
        {
          "name": "target",
          "label": "Existing network",
          "elements": [
            {
              "name": "hub",
              "label": "Virtual hub",
              "type": "Microsoft.Solutions.ResourceSelector",
              "resourceType": "Microsoft.Network/virtualHubs",
              "options": {
                "filter": {
                  "subscription": "onBasics",
                  "location": "all"
                }
              }
            },
            {
              "name": "policy",
              "label": "Attached firewall policy",
              "type": "Microsoft.Solutions.ResourceSelector",
              "resourceType": "Microsoft.Network/firewallPolicies",
              "options": {
                "filter": {
                  "subscription": "onBasics",
                  "location": "all"
                }
              }
            },
            {
              "name": "workspace",
              "label": "Firewall log workspace",
              "type": "Microsoft.Solutions.ResourceSelector",
              "resourceType": "Microsoft.OperationalInsights/workspaces",
              "options": {
                "filter": {
                  "subscription": "onBasics",
                  "location": "all"
                }
              }
            }
          ]
        },
        {
          "name": "tests",
          "label": "Test resources",
          "elements": [
            {
              "name": "vmSize",
              "label": "VM size",
              "type": "Microsoft.Common.TextBox",
              "constraints": {
                "required": true
              },
              "defaultValue": "Standard_B1ms"
            },
            {
              "name": "spokeAPrefix",
              "label": "Spoke A IPv4 prefix",
              "type": "Microsoft.Common.TextBox",
              "constraints": {
                "required": true
              },
              "defaultValue": "10.251.0.0/24"
            },
            {
              "name": "spokeBPrefix",
              "label": "Spoke B IPv4 prefix",
              "type": "Microsoft.Common.TextBox",
              "constraints": {
                "required": true
              },
              "defaultValue": "10.252.0.0/24"
            },
            {
              "name": "adminUsername",
              "label": "VM administrator name",
              "type": "Microsoft.Common.TextBox",
              "constraints": {
                "required": true
              },
              "defaultValue": "harnessadmin"
            },
            {
              "name": "publishReport",
              "label": "Update workbook assessment",
              "type": "Microsoft.Common.DropDown",
              "defaultValue": "false",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ]
              }
            },
            {
              "name": "cleanupAfter",
              "label": "Remove test resources after success",
              "type": "Microsoft.Common.DropDown",
              "defaultValue": "true",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "outputs": {
      "parameters": {
        "coreResourceGroup": "[first(skip(split(steps('target').hub.id, '/'), 4))]",
        "hubName": "[steps('target').hub.name]",
        "location": "[steps('target').hub.location]",
        "policyResourceGroup": "[first(skip(split(steps('target').policy.id, '/'), 4))]",
        "workspaceResourceGroup": "[first(skip(split(steps('target').workspace.id, '/'), 4))]",
        "firewallPolicyResourceId": "[steps('target').policy.id]",
        "workspaceResourceId": "[steps('target').workspace.id]",
        "vmSize": "[steps('tests').vmSize]",
        "spokeAPrefix": "[steps('tests').spokeAPrefix]",
        "spokeBPrefix": "[steps('tests').spokeBPrefix]",
        "adminUsername": "[steps('tests').adminUsername]",
        "publishReport": "[bool(steps('tests').publishReport)]",
        "cleanupAfter": "[bool(steps('tests').cleanupAfter)]"
      },
      "kind": "ResourceGroup",
      "location": "[steps('basics').resourceScope.location.name]",
      "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]"
    }
  }
}
